# Copy this file to .env and fill in your own values.
# (Prisma CLI reads .env; Next.js reads both .env and .env.local.)

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/sewage_repair_service"

# Secret used to sign login session cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
